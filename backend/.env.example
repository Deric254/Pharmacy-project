ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# A local Redis server. Set REDIS_MODE=memory instead to run without one
# (single process only -- this is what the desktop app does).
REDIS_URL=redis://localhost:6379/0

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-real-secret

# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=changeme-generate-a-real-32-byte-base64-key

# Only needed when running the frontend with `npm run dev` (Vite serves it
# on 5173) against this backend; the packaged app is served same-origin.
CORS_ORIGINS=["http://localhost:5173"]
