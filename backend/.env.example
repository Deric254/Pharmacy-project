ENVIRONMENT=development
DATABASE_URL=mysql+asyncmy://root:root@mysql:3306/pharmacy_erp
REDIS_URL=redis://redis:6379/0

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-a-real-secret

# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=changeme-generate-a-real-32-byte-base64-key

# In the docker-compose setup, the browser only ever talks to nginx
# (localhost:8080), which reverse-proxies /api internally to this
# service -- so from the browser's point of view every request is
# same-origin and CORS never actually applies. localhost:5173 is only
# needed when running the frontend directly via `npm run dev` against
# this backend without the nginx proxy in between.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
